# Set these values in the hosting provider. Use a private PostgreSQL instance.
SPRING_PROFILES_ACTIVE=production
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres.example.invalid:5432/gridmind
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Configure an administrator and restrict access to the evaluation instance.
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_MODE=false
AUTH_REGISTRATION_ENABLED=false

# Enter the public origin only if the frontend uses a different origin.
CORS_ALLOWED_ORIGIN_PATTERNS=https://gridmind.example.invalid

# Configure hardware or Claude only if the deployment uses them.
TELEMETRY_DEVICE_TOKEN=
CLAUDE_API_KEY=
